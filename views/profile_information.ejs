<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Minha conta</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <!-- CSS -->
    <link rel="stylesheet" href="/css/home.css">
</head>

<body>

    <header class="mb-3">

           <!-- Header Principal com as classes adicionadas -->
    <header class="mb-3">
        <!-- Barra de Acessibilidade Superior com as classes adicionadas -->
        <div class="accessibility-bar" role="navigation" aria-label="Acessibilidade">
            <a href="#main-content" accesskey="1">Ir para o conteúdo</a>
            <button type="button" onclick="toggleContraste()" aria-label="Ativar alto contraste">Alto Contraste</button>
        </div>
        
        <nav class="site-header">
            <!-- Logotipo -->
            <div class="logo">
                <a href="/" aria-label="Página inicial GalinhasGordas">
                    <img src="/imagens/logo.png" alt="GalinhasGordas Home" width="120"> <!--Removeu o i-->
                </a>
            </div>
            <!-- Ações -->
            <div class="d-none d-sm-flex user-actions">
                <a href="/home" class="action-link">
                    Home
                </a>
                <a href="/carrinho" class="action-link">
                    Carrinho (<span class="cart-badge">0</span>)
                </a>
            </div>
        </nav>
    </header>

    <main id="main-content" class="container-md">
        <h1>Minha conta</h1>
        <p>Informações da sua conta</p>
        <div class="container-md mt-4">
            <!-- Nome -->
            <div class="mb-3">
                <label class="form-label">
                    Nome
                </label>
                <input
                    type="text"
                    class="form-control"
                    value="<%= USER.name %>"
                    readonly
                >
            </div>
            <!-- Username -->
            <div class="mb-3">
                <label class="form-label">
                    Username
                </label>
                <input
                    type="text"
                    class="form-control"
                    value="<%= USER.username %>"
                    readonly
                >
            </div>
            <!-- Categoria -->
            <div class="mb-3">
                <label class="form-label">
                    Categoria
                </label>
                <input
                    type="text"
                    class="form-control"
                    value="<%= USER.category %>"
                    readonly
                >
            </div>
            <!-- Botões -->
            <div class="mt-4">

                <a
                    href="/<%= USER.username %>/edit-profile"
                    class="btn btn-primary"
                >
                    Editar informações
                </a>

                <a
                    href="/<%= USER.username %>/password-change"
                    class="btn btn-warning"
                >
                    Alterar senha
                </a>

                <a
                    href="/<%= USER.username %>/view-addresses"
                    class="btn btn-secondary"
                >
                    Meus endereços
                </a>

            </div>

        </div>

    </main>

</body>

</html>
