<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>home</title>

     <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <link class="style-local" rel="stylesheet" href="/css/home.css">
    
</head>

<body>
        
    <!-- Barra de Acessibilidade Superior com as classes adicionadas -->
    <div class="accessibility-bar" role="navigation" aria-label="Acessibilidade">
        <a href="#main-content" accesskey="1">Ir para o conteúdo</a>
        <button type="button" onclick="toggleContraste()" aria-label="Ativar alto contraste">Alto Contraste</button>
    </div>

    <!-- Header Principal com as classes adicionadas -->
    <header class="site-header">
        
        <!-- Logotipo -->
        <div class="logo">
            <a href="/" aria-label="Página inicial GalinhasGordas">
                <img src="/imagens/logo.png" alt="GalinhasGordas Home" width="120">
            </a>
        </div>

        <!-- Área de Login e Carrinho com as classes adicionadas -->
        <div class="user-actions">
            
            <!-- Área de Login -->
            <a href="/login" class="action-link" aria-label="Entrar na minha conta">
                 Minha Conta / Entrar
            </a>

            <!-- Carrinho de Compras -->
            <a href="/carrinho" class="action-link" aria-label="Ver carrinho de compras, 0 itens">
                 Carrinho (<span class="cart-badge">0</span>)
            </a>

        </div>

    </header>

    <main class="container-fluid mt-3 row">
        <aside class="col-md-4 p-4">
            <form action="/pesquisa" method="GET" role="search" class="input-group">
                <input 
                    type="search" 
                    id="search-input"
                    class="form-control"
                    name="q" 
                    placeholder="Pesquisar produtos..." 
                    aria-label="Buscar no site"
                    required
                >
                <button type="submit" class="input-group-text btn btn-primary">Buscar</button>
            </form>
        </aside>

        <article class="col-md-8 p-4">
            <div class="row">
                <div class="col-md-4">
                    <div class="card card-body">
                        <h1 class="card-title">Produto 1</h1>
                        <p>Lorem ipsum...</p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card card-body">
                        <h1 class="card-title">Produto 2</h1>
                        <p>Lorem ipsum...</p>
                    </div>
                </div>
            </div>
        </article>

        
    </main>
</html>