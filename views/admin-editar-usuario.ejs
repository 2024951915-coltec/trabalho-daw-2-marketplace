<!DOCTYPE html>
<html lang="pt-BR">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        <title>ADMIN-EDITAR_USUARIO</title>

        <!-- Bootstrap -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
            rel="stylesheet">

        <!--Bootstrap JS Script-->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" 
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" 
        crossorigin="anonymous"></script>
        <link rel="stylesheet" href="/css/home.css">
        <link rel="stylesheet" href="/css/admin.css">
        
    </head>

    <body>
        <header class="mb-3">
            <!-- Barra de Acessibilidade Superior com as classes adicionadas -->
            <div class="accessibility-bar" role="navigation" aria-label="Acessibilidade">
                <a href="#main-content" accesskey="1">Ir para o conteúdo</a>
                <button type="button" id="high-contrast" onclick="toggleContraste()" aria-label="Ativar alto contraste">Alto Contraste</button>
            </div>
            
            <nav class="site-header">
                <!-- Logotipo -->
                <div class="logo">
                    <a href="/" aria-label="Página inicial GalinhasGordas">
                        <img src="/imagens/logo.png" alt="GalinhasGordas Home" width="120"> <!--Removeu o i-->
                    </a>
                </div>

                <!-- MENU COMPUTADOR/TV -->
                <div class="d-none d-sm-flex user-actions">
                    
                    <!-- Área de Login -->
                    <a href="/config" class="action-link" aria-label="Entrar na minha conta">
                        Minha Conta (<strong>@<%= USER.username %></strong>)
                    </a>

                    <!-- Carrinho de Compras -->
                    <a href="/<%= USER.username %>/shopping-cart" class="action-link" aria-label="Ver carrinho de compras, 0 itens">
                        Carrinho (<span class="cart-badge">0</span>)
                    </a>

                </div>

                <!-- MENU TELEFONE/PDA -->
                <div class="d-block d-sm-none">
                    <!--TODO: adicionar menu para mobile-->
                    <a class="btn btn-outline-primary" data-bs-toggle="offcanvas" href="#sm-offcanvas" role="button" aria-controls="sm-offcanvas">
                        &#9776;secondary
                    </a>

                    <div class="offcanvas offcanvas-start" id="sm-offcanvas">
                        <div class="offcanvas-header">
                            <h5 class="offcanvas-title" id="offcanvasExampleLabel">Menu</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                        </div>

                        <div class="offcanvas-body">
                            <!-- Área de Login -->
                            <a href="/config" class="btn btn-outline-primary" aria-label="Entrar na minha conta">
                                Minha Conta (<strong>@<%= USER.username %></strong>)
                            </a>

                            <!-- Carrinho de Compras -->
                            <a href="/<%= USER.username %>/shopping-cart" class="btn btn-outline-primary" aria-label="Ver carrinho de compras, 0 itens">
                                Carrinho (<span class="cart-badge">0</span>)
                            </a>
                        </div>
                    </div>
                </div>
            </nav>

        </header>

            <main id="main-content" class="container-md mt-4 admin-main">

        <div class="d-flex justify-content-between align-items-center admin-header">

            <h2>Editar usuário</h2>

            <a class="btn" href="/admin/usuarios">
                Voltar
            </a>

        </div>

        <div class="container-md mt-4">

            <h3 class="admin-section-title">
                Dados do usuário
            </h3>

            <p class="admin-section-description">
                Edite as informações do usuário selecionado.
            </p>

            <form
                action="/admin/usuarios/<%= USUARIO_EDITAR.id %>/editar"
                method="POST"
            >

                <!-- Nome -->
                <div class="mb-3">

                    <label for="name" class="form-label">
                        Nome
                    </label>

                    <input
                        type="text"
                        class="form-control"
                        id="name"
                        name="name"
                        value="<%= USUARIO_EDITAR.name %>"
                        required
                    >

                </div>


                <!-- Username -->
                <div class="mb-3">

                    <label for="username" class="form-label">
                        Nome de usuário
                    </label>

                    <input
                        type="text"
                        class="form-control"
                        id="username"
                        name="username"
                        value="<%= USUARIO_EDITAR.username %>"
                        required
                    >

                </div>

                <div class="mb-3">

                    <label for="senha" class="form-label">
                        Nova senha
                    </label>

                    <input
                        type="password"
                        class="form-control"
                        id="senha"
                        name="senha"
                        placeholder="Deixe em branco para manter a senha atual"
                    >

                    <div class="form-text">
                        Preencha apenas se quiser alterar a senha do usuário.
                    </div>

                </div>


                <!-- Categoria -->
                <div class="mb-3">

                    <label for="category" class="form-label">
                        Categoria
                    </label>

                    <select
                        class="form-select"
                        id="category"
                        name="category"
                        required
                    >

                        <option
                            value="user"
                            <%= USUARIO_EDITAR.category === 'user' ? 'selected' : '' %>
                        >
                            Usuário
                        </option>

                        <option
                            value="vendedor"
                            <%= USUARIO_EDITAR.category === 'vendedor' ? 'selected' : '' %>
                        >
                            Vendedor
                        </option>

                        <option
                            value="admin"
                            <%= USUARIO_EDITAR.category === 'admin' ? 'selected' : '' %>
                        >
                            Administrador
                        </option>

                    </select>

                </div>


                <!-- Botões -->
                <div class="d-flex gap-2">

                    <button
                        type="submit"
                        class="btn btn-primary"
                    >
                        Salvar alterações
                    </button>

                    <a
                        href="/admin/usuarios"
                        class="btn btn-outline-secondary"
                    >
                        Cancelar
                    </a>

                </div>

            </form>

        </div>
        <link rel="stylesheet" href="/css/high-contrast.css">
        <script src="/js/high-contrast-override.js"></script>
        <link rel="stylesheet" href="/css/font-size.css">
    <script src="/js/font-size-override.js"></script>
    </main>
    </body>
</html>