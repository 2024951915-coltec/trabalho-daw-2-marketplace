<!DOCTYPE html>
<html lang="pt-br">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>home</title>

        <!-- Bootstrap -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
            rel="stylesheet">

        <!--Bootstrap JS Script-->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" 
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" 
        crossorigin="anonymous"></script>

        <link class="style-local" rel="stylesheet" href="/css/home.css">
        
    </head>

    <body>
            
        

        <!-- Header Principal com as classes adicionadas -->
        <header class="mb-3">
            <!-- Barra de Acessibilidade Superior com as classes adicionadas -->
            <div class="accessibility-bar" role="navigation" aria-label="Acessibilidade">
                <a href="#main-content" accesskey="1">Ir para o conteúdo</a>
                <button type="button" id="high-contrast" onclick="toggleContraste()" aria-label="Ativar alto contraste">Alto Contraste</button>
            </div>
            
            <nav class="site-header">
                <!-- Logotipo -->
                <div class="logo">
                    <a href="/" aria-label="Página inicial GalinhasGordas">
                        <img src="/imagens/logo.png" alt="GalinhasGordas Home" width="120"> <!--Removeu o i-->
                    </a>
                </div>

                <!-- MENU COMPUTADOR/TV -->
                <div class="d-none d-sm-flex user-actions">
                    
                    <!-- Área de Login -->
                    <% if(USER) { %>
                    <a href="/config" class="btn btn-outline-primary" aria-label="Entrar na minha conta">
                        Minha Conta (<strong>@<%= USER.username %></strong>)
                    </a>
                    <% } else { %>
                    <a href="/login" class="btn btn-outline-primary" aria-label="Entrar na minha conta">
                        Entrar ou cadastrar
                    </a>
                    <% } %>

                    <!-- Carrinho de Compras -->
                    <% if(USER) { %>
                            <a href="/<%= USER.username %>/shopping-cart" class="btn btn-outline-primary" aria-label="Ver carrinho de compras, 0 itens">
                                Carrinho (<span class="cart-badge">0</span>)
                            </a>
                            <% } else { %>
                            <a href="/login" class="btn btn-outline-primary" aria-label="Ver carrinho de compras, 0 itens">
                                Carrinho (<span class="cart-badge">0</span>)
                            </a>
                            <% } %>

                </div>

                <!-- MENU TELEFONE/PDA -->
                <div class="d-block d-sm-none">
                    <!--TODO: adicionar menu para mobile-->
                    <a class="btn btn-outline-primary" data-bs-toggle="offcanvas" href="#sm-offcanvas" role="button" aria-controls="sm-offcanvas">
                        &#9776;
                    </a>

                    <div class="offcanvas offcanvas-start" id="sm-offcanvas">
                        <div class="offcanvas-header">
                            <h5 class="offcanvas-title" id="offcanvasExampleLabel">Menu</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                        </div>

                        <div class="offcanvas-body">
                            <!-- Área de Login -->
                            <% if(USER) { %>
                            <a href="/config" class="btn btn-outline-primary" aria-label="Entrar na minha conta">
                                Minha Conta (<strong>@<%= USER.username %></strong>)
                            </a>
                            
                            <a href="/login" class="btn btn-outline-primary" aria-label="Entrar na minha conta">
                                Entrar ou cadastrar
                            </a>
                            <% } %>

                            <!-- Carrinho de Compras -->
                            <% if(USER) { %>
                            <a href="/<%= USER.username %>/shopping-cart" class="btn btn-outline-primary" aria-label="Ver carrinho de compras, 0 itens">
                                Carrinho (<span class="cart-badge">0</span>)
                            </a>
                            <% } else { %>
                            <a href="/login" class="btn btn-outline-primary" aria-label="Ver carrinho de compras, 0 itens">
                                Carrinho (<span class="cart-badge">0</span>)
                            </a>
                            <% } %>
                        </div>
                    </div>
                </div>
            </nav>

        </header>

        <main id="maincontent" class="container-md">
            <div class="card card-body">
                <div class="row">
                    <aside class="col-md-4 card-body">
                        <img src="/data/uploads/<%= PRODUTO.photo_id %>" alt="Foto de <%= PRODUTO.name %>" class="img-fluid">
                    </aside>

                    <aside class="col-md-8 card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <h1><%= PRODUTO.name %></h1>
                            <a href="/home" class="btn btn-outline-primary">Voltar</a>
                        </div>
                        <h4><%= PRODUTO.loja.name %></h4>
                        <h5 class="text-secondary">R$ <%= PRODUTO.preco.toFixed(2) %></h5>
                        

                        <div class="container mt-5">
                            <p>Quantidade em estoque: <%= PRODUTO.stock %> uni.</p>
                            <% if(USER && PRODUTO.stock > 0) { %>
                            <div class="card card-body">
                                <form action="/products/<%= PRODUTO.id %>/shopping-cart" method="POST">
                                    <div class="row justify-content-between align-items-center">
                                        <div class="col-md-auto mb-3 mb-md-0">
                                            <label for="quantidade" class="form-label">Quantidade</label>
                                            <input type="number" class="form-control" id="quantidade" name="quantidade" min="1" value="1" required>
                                        </div>   
                                        <div class="col-md-auto">
                                            <input type="submit" class="btn btn-primary" value="Adicionar ao carrinho">
                                        </div>  
                                    </div>
                                </form>
                                <form action="/<%=  USER.username%>/checkout" class="mt-3">
                                    <!--Faz a coluna ajustar automaticamente com base no tamanho do conteúdo-->
                                    <div class="d-block d-md-flex justify-content-end">
                                        <input type="submit" class="btn btn-primary" value="Comprar agora">
                                    </div>
                                </form>
                            </div>
                            <% } else if ( USER ) { %>
                                <p class="text-secondary">Produto não disponível :/</p>
                            <% } else {%>
                            <a href="/login" class="btn btn-outline-primary">
                                Entre na sua conta para 
                                adicionar ao carrinho
                            </a>
                            <% } %>
                        </div>
                    </aside>
                </div>
            </div>

            <article class="card card-body my-3">
                <h3>Descrição do lojista:</h3>
                <%= PRODUTO.description %>
            </article>

            <article class="card card-body my-3">
                <h3>Avaliações:</h3>
                <% if(USER && HAS_BOUGHT) { %>
                    <div class="row mb-3">
                        <div class="col-md-7">
                        <form action="/product/<%= PRODUTO.id.toString(16).padStart(16, '0') %>/submit-review" method="POST" class="form-control mb-3">
                            <div class="row g-3 align-items-start mb-3">
                                <div class="col-md-3">
                                    <div class="input-group">
                                        <input class="form-control" type="number" name="rating" id="rating" step="1" max="10" min="0" placeholder="Nota">
                                        <span class="input-group-text">/10</span>
                                    </div>
                                </div>
                                <div class="col-md-9">
                                    <textarea class="form-control" name="msg" id="msg" rows="3" placeholder="Sua avaliação" required></textarea>
                                </div>
                            </div>
                            <div class="d-block d-md-flex justify-content-end">
                                <input type="submit" class="btn btn-primary" value="Enviar">
                            </div>
                        </form>
                        </div>
                    </div>
                <% } else if(USER && !HAS_BOUGHT){ %>
                    <div class="card text-white bg-danger">
                        <div class="card-body">
                            <p class="card-text">
                                Precisa ter comprado o produto e tê-lo recebido para avaliar
                            </p>
                        </div>
                    </div>
                <% } else { %>
                <div class="container">
                    <a class="btn btn-outline-warning mb-3" href="/login">
                        Entre para postar sua avaliação
                    </a>
                </div>
                <% } %>
                <div class="container-md">
                <% if(REVIEWS) { %>
                    <% REVIEWS.forEach((review) => { %>
                    <div class="card card-body mb-3">
                        <div class="d-block d-md-flex justify-content-between">
                            <h4 class="card-title">@<%= review.usuario.username %></h4>
                            <p class="card-title text-secondary"><%= review.rating %>/10</p>
                        </div>
                        <p class="card-text"><%= review.message %></p>
                    </div>
                    <% }) %>
                <% } %>
                </div>
            </article>
        </main>

        <link rel="stylesheet" href="/css/high-contrast.css">
        <script src="/js/high-contrast-override.js"></script>
    </body>
</html>