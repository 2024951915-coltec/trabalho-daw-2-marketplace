<!DOCTYPE html>

<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Editar perfil</title>

    <link rel="stylesheet" href="/css/vendedor.css">

    <!-- Bootstrap -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous">
    </script>

    <link class="style-local" rel="stylesheet" href="/css/home.css">
</head>

<body>

    <header class="mb-3">

        <!-- Barra de Acessibilidade -->
        <div
            class="accessibility-bar"
            role="navigation"
            aria-label="Acessibilidade"
        >
            <a href="#main-content" accesskey="1">
                Ir para o conteúdo
            </a>

            <button
                type="button"
                id="high-contrast"
                onclick="toggleContraste()"
                aria-label="Ativar alto contraste"
            >
                Alto Contraste
            </button>
        </div>


        <nav class="site-header">

            <!-- Logo -->
            <div class="logo">
                <a href="/" aria-label="Página inicial GalinhasGordas">
                    <img
                        src="/imagens/logo.png"
                        alt="GalinhasGordas Home"
                        width="120"
                    >
                </a>
            </div>


            <!-- MENU COMPUTADOR -->
            <div class="d-none d-sm-flex user-actions">

                <!-- Minha conta -->
                <a
                    href="/config"
                    class="action-link"
                    aria-label="Minha conta"
                >
                    Minha Conta
                    (<strong>@<%= USER.username %></strong>)
                </a>


                <!-- Carrinho -->
                <a
                    href="/<%= USER.username %>/shopping-cart"
                    class="action-link"
                    aria-label="Ver carrinho de compras"
                >
                    Carrinho
                    (<span class="cart-badge">0</span>)
                </a>

            </div>


            <!-- MENU CELULAR -->
            <div class="d-block d-sm-none">

                <a
                    class="btn btn-outline-primary"
                    data-bs-toggle="offcanvas"
                    href="#sm-offcanvas"
                    role="button"
                    aria-controls="sm-offcanvas"
                >
                    &#9776;
                </a>


                <div
                    class="offcanvas offcanvas-start"
                    id="sm-offcanvas"
                >

                    <div class="offcanvas-header">

                        <h5
                            class="offcanvas-title"
                            id="offcanvasExampleLabel"
                        >
                            Menu
                        </h5>

                        <button
                            type="button"
                            class="btn-close"
                            data-bs-dismiss="offcanvas"
                            aria-label="Close">
                        </button>

                    </div>


                    <div class="offcanvas-body">

                        <!-- Minha conta -->
                        <a
                            href="/config"
                            class="btn btn-outline-primary"
                            aria-label="Minha conta"
                        >
                            Minha Conta
                            (<strong>@<%= USER.username %></strong>)
                        </a>


                        <!-- Carrinho -->
                        <a
                            href="/<%= USER.username %>/shopping-cart"
                            class="btn btn-outline-primary"
                            aria-label="Ver carrinho de compras"
                        >
                            Carrinho
                            (<span class="cart-badge">0</span>)
                        </a>

                    </div>

                </div>

            </div>

        </nav>

    </header>


    <main
        id="main-content"
        class="adicionar-produto container-md"
    >

        <h2>Editar Perfil</h2>


        <!--
            IMPORTANTE:
            O POST vai para /editprofile,
            porque essa é a rota definida no seu pages.js.
        -->
        <form
            class="form-control"
            action="/edit_profile"
            method="POST"
        >

            <!-- Nome -->
            <div class="campo-produto mb-3">

                <label
                    for="name"
                    class="form-label"
                >
                    Nome
                </label>

                <input
                    type="text"
                    class="form-control"
                    id="name"
                    name="name"
                    value="<%= USER.name %>"
                    required
                >

            </div>


            <!-- Nome de usuário -->
            <div class="campo-produto mb-3">

                <label
                    for="username"
                    class="form-label"
                >
                    Nome de usuário
                </label>

                <input
                    type="text"
                    class="form-control"
                    id="username"
                    name="username"
                    value="<%= USER.username %>"
                    required
                >

            </div>


            <!-- Botões -->
            <div class="mt-3">

                <!-- Cancelar -->
                <a
                    href="/config"
                    class="btn btn-secondary"
                >
                    Cancelar
                </a>


                <!-- Salvar -->
                <button
                    type="submit"
                    class="btn btn-primary"
                >
                    Salvar alterações
                </button>

            </div>

        </form>

    </main>
    <link rel="stylesheet" href="/css/high-contrast.css">
    <script src="/js/high-contrast-override.js"></script>
    <link rel="stylesheet" href="/css/font-size.css">
    <script src="/js/font-size-override.js"></script>
</body>

</html>