<!DOCTYPE html>
<html lang="pt-BR">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        <title>ADMINISTRADOR</title>

        <!-- Bootstrap -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
            rel="stylesheet">

        <!--Bootstrap JS Script-->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" 
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" 
        crossorigin="anonymous"></script>
        <link rel="stylesheet" href="/css/home.css">
        <link rel="stylesheet" href="/css/admin.css">
        
    </head>

    <body>
        <header class="mb-3">
            <!-- Barra de Acessibilidade Superior com as classes adicionadas -->
            <div class="accessibility-bar" role="navigation" aria-label="Acessibilidade">
                <a href="#main-content" accesskey="1">Ir para o conteúdo</a>
                <button type="button" id="high-contrast" onclick="toggleContraste()" aria-label="Ativar alto contraste">Alto Contraste</button>
            </div>
            
            <nav class="site-header">
                <!-- Logotipo -->
                <div class="logo">
                    <a href="/" aria-label="Página inicial GalinhasGordas">
                        <img src="/imagens/logo.png" alt="GalinhasGordas Home" width="120"> <!--Removeu o i-->
                    </a>
                </div>

                <!-- MENU COMPUTADOR/TV -->
                <div class="d-none d-sm-flex user-actions">
                    
                    <!-- Área de Login -->
                    <a href="/config" class="action-link" aria-label="Entrar na minha conta">
                        Minha Conta (<strong>@<%= USER.username %></strong>)
                    </a>

                    <!-- Carrinho de Compras -->
                    <a href="/<%= USER.username %>/shopping-cart" class="action-link" aria-label="Ver carrinho de compras, 0 itens">
                        Carrinho (<span class="cart-badge">0</span>)
                    </a>

                </div>

                <!-- MENU TELEFONE/PDA -->
                <div class="d-block d-sm-none">
                    <!--TODO: adicionar menu para mobile-->
                    <a class="btn btn-outline-primary" data-bs-toggle="offcanvas" href="#sm-offcanvas" role="button" aria-controls="sm-offcanvas">
                        &#9776;secondary
                    </a>

                    <div class="offcanvas offcanvas-start" id="sm-offcanvas">
                        <div class="offcanvas-header">
                            <h5 class="offcanvas-title" id="offcanvasExampleLabel">Menu</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                        </div>

                        <div class="offcanvas-body">
                            <!-- Área de Login -->
                            <a href="/config" class="btn btn-outline-primary" aria-label="Entrar na minha conta">
                                Minha Conta (<strong>@<%= USER.username %></strong>)
                            </a>

                            <!-- Carrinho de Compras -->
                            <a href="/<%= USER.username %>/shopping-cart" class="btn btn-outline-primary" aria-label="Ver carrinho de compras, 0 itens">
                                Carrinho (<span class="cart-badge">0</span>)
                            </a>
                        </div>
                    </div>
                </div>
            </nav>

        </header>

        <main id="maincontent" class="container-md mt-4 admin-main">

            <div class="d-flex justify-content-between align-items-center admin-header">
                <h2>Painel Administrativo</h2>

                <a class="btn btn-primary" href="/config">
                    Voltar
                </a>
            </div>

            <div class="container-md mt-4">

                <h3 class="admin-section-title">
                    Gerenciamento do sistema
                </h3>

                <p class="admin-section-description">
                    Selecione uma opção para administrar o marketplace.
                </p>

                <div class="row mt-4">

                    <!-- Gerenciamento de usuários -->
                    <div class="col-md-6 col-lg-4 mb-4">
                        <a href="/admin/usuarios"
                        class="text-decoration-none text-dark">

                            <div class="card h-100 shadow-sm">
                                <div class="card-body">
                                    <h4 class="card-title">
                                        Gerenciamento de usuários
                                    </h4>

                                    <p class="card-text">
                                        Gerenciar os usuários cadastrados no sistema.
                                    </p>
                                </div>
                            </div>

                        </a>
                    </div>

                    <!-- Gerenciamento de vendedores -->
                    <div class="col-md-6 col-lg-4 mb-4">
                        <a href="/admin/vendedores"
                        class="text-decoration-none text-dark">

                            <div class="card h-100 shadow-sm">
                                <div class="card-body">
                                    <h4 class="card-title">
                                        Gerenciamento de vendedores
                                    </h4>

                                    <p class="card-text">
                                        Gerenciar vendedores e suas lojas.
                                    </p>
                                </div>
                            </div>

                        </a>
                    </div>

                    <!-- Gerenciamento de categorias -->
                    <div class="col-md-6 col-lg-4 mb-4">
                        <a href="/admin/categorias"
                        class="text-decoration-none text-dark">

                            <div class="card h-100 shadow-sm">
                                <div class="card-body">
                                    <h4 class="card-title">
                                        Gerenciamento de categorias
                                    </h4>

                                    <p class="card-text">
                                        Criar, editar e remover categorias de produtos.
                                    </p>
                                </div>
                            </div>

                        </a>
                    </div>

                    <!-- Gerenciamento de produtos -->
                    <div class="col-md-6 col-lg-4 mb-4">
                        <a href="/admin/produtos"
                        class="text-decoration-none text-dark">

                            <div class="card h-100 shadow-sm">
                                <div class="card-body">
                                    <h4 class="card-title">
                                        Gerenciamento de produtos
                                    </h4>

                                    <p class="card-text">
                                        Visualizar e gerenciar os produtos cadastrados.
                                    </p>
                                </div>
                            </div>

                        </a>
                    </div>

                </div>

            </div>

        </main>

        <link rel="stylesheet" href="/css/high-contrast.css">
        <script src="/js/high-contrast-override.js"></script>
    </body>
</html>