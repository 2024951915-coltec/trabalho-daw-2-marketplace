<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Editar Produto</title>

    <!-- Bootstrap -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js">
    </script>

    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>

<body>

    <header class="mb-3">

        <div
            class="accessibility-bar"
            role="navigation"
            aria-label="Acessibilidade"
        >

            <a href="#main-content" accesskey="1">
                Ir para o conteúdo
            </a>

            <button
                type="button"
                onclick="toggleContraste()"
                aria-label="Ativar alto contraste"
            >
                Alto Contraste
            </button>

        </div>


        <nav class="site-header">

            <div class="logo">

                <a
                    href="/"
                    aria-label="Página inicial GalinhasGordas"
                >

                    <img
                        src="/imagens/logo.png"
                        alt="GalinhasGordas Home"
                        width="120"
                    >

                </a>

            </div>


            <div class="d-none d-sm-flex user-actions">

                <a
                    href="/config"
                    class="action-link"
                    aria-label="Minha conta"
                >
                    Minha Conta
                    (<strong>@<%= USER.username %></strong>)
                </a>

                <a
                    href="/admin"
                    class="action-link"
                >
                    Painel Administrativo
                </a>

            </div>

        </nav>

    </header>


    <main
        id="main-content"
        class="container-md mt-4 admin-main"
    >

        <div
            class="d-flex justify-content-between align-items-center admin-header"
        >

            <h2>Editar Produto</h2>

            <a
                class="btn"
                href="/admin/produtos"
            >
                Voltar
            </a>

        </div>


        <div class="container-md mt-4">

            <h3 class="admin-section-title">
                Dados do produto
            </h3>

            <p class="admin-section-description">
                Altere as informações do produto selecionado.
            </p>


            <form
                action="/admin/produtos/<%= PRODUTO_EDITAR.id %>/editar"
                method="POST"
            >

                <!-- Nome -->
                <div class="mb-3">

                    <label
                        for="name"
                        class="form-label"
                    >
                        Nome do produto
                    </label>

                    <input
                        type="text"
                        class="form-control"
                        id="name"
                        name="name"
                        value="<%= PRODUTO_EDITAR.name %>"
                        required
                    >

                </div>


                <!-- Descrição -->
                <div class="mb-3">

                    <label
                        for="description"
                        class="form-label"
                    >
                        Descrição
                    </label>

                    <textarea
                        class="form-control"
                        id="description"
                        name="description"
                        rows="4"
                        required
                    ><%= PRODUTO_EDITAR.description %></textarea>

                </div>


                <!-- Preço -->
                <div class="mb-3">

                    <label
                        for="preco"
                        class="form-label"
                    >
                        Preço
                    </label>

                    <input
                        type="number"
                        class="form-control"
                        id="preco"
                        name="preco"
                        step="0.01"
                        min="0"
                        value="<%= PRODUTO_EDITAR.preco %>"
                        required
                    >

                </div>


                <!-- Estoque -->
                <div class="mb-3">

                    <label
                        for="stock"
                        class="form-label"
                    >
                        Estoque
                    </label>

                    <input
                        type="number"
                        class="form-control"
                        id="stock"
                        name="stock"
                        min="0"
                        value="<%= PRODUTO_EDITAR.stock %>"
                        required
                    >

                </div>


                <!-- Categoria -->
                <div class="mb-3">

                    <label
                        for="categoriaId"
                        class="form-label"
                    >
                        Categoria
                    </label>

                    <select
                        class="form-select"
                        id="categoriaId"
                        name="categoriaId"
                        required
                    >

                        <% CATEGORIAS.forEach(categoria => { %>

                            <option
                                value="<%= categoria.id %>"
                                <%= Number(PRODUTO_EDITAR.categoriaId) === Number(categoria.id) ? 'selected' : '' %>
                            >
                                <%= categoria.name %>
                            </option>

                        <% }) %>

                    </select>

                </div>


                <!-- Loja -->
                <div class="mb-3">

                    <label
                        for="lojaId"
                        class="form-label"
                    >
                        Loja
                    </label>

                    <select
                        class="form-select"
                        id="lojaId"
                        name="lojaId"
                        required
                    >

                        <% LOJAS.forEach(loja => { %>

                            <option
                                value="<%= loja.id %>"
                                <%= Number(PRODUTO_EDITAR.lojaId) === Number(loja.id) ? 'selected' : '' %>
                            >
                                <%= loja.name %>
                            </option>

                        <% }) %>

                    </select>

                </div>


                <!-- Botões -->
                <div class="d-flex gap-2">

                    <button
                        type="submit"
                        class="btn btn-primary"
                    >
                        Salvar alterações
                    </button>

                    <a
                        href="/admin/produtos"
                        class="btn btn-outline-secondary"
                    >
                        Cancelar
                    </a>

                </div>

            </form>

        </div>

    </main>

</body>
</html>