<!DOCTYPE html>
<html lang="pt-br">

<head>

    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Login</title>

    <!-- CSS -->
    <link rel="stylesheet" href="/css/cadastro.css">

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet">
    
    <!--Bootstrap JS Script-->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" 
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" 
        crossorigin="anonymous"></script>

</head>

<body>

    <div class="Cadastro my-5">
        <h2>Cadastrar</h2>
        <form action="#" class="container" method="POST">

            <div class="input">
                <label for="nome">Nome</label>
                <input type="text" id="nome" name="nome" required placeholder="João Silva...">
            </div>

            <div class="input">
                <label for="username">Username</label>
                <input type="text" id="username" name="username" required placeholder="joaosilva...">
            </div>
            
    
            <div class="input">
                <label for="senha">Senha</label>
                <input type="password" id="senha" name="senha" required placeholder="...">
            </div>

           <label>Você deseja se cadastrar como:</label>

            <div class="tipo-usuario">

                <label class="tipo-opcao" for="cliente">
                    <input
                        type="radio"
                        id="cliente"
                        name="category"
                        value="user"
                        checked
                    >
                    Cliente
                </label>

                <label class="tipo-opcao" for="vendedor">
                    <input
                        type="radio"
                        id="vendedor"
                        name="category"
                        value="vendedor"
                    >
                    Vendedor
                </label>

            </div>
            <div class="input">
                <button type="submit">Cadastrar</button>
            </div>
        </form>
        
        <p>Já tem uma conta? <a href="/login">Entre aqui</a></p>

        <button id="high-contrast" class="btn btn-primary">Auto contraste</button>
    </div>
    
    <link rel="stylesheet" href="/css/high-contrast.css">
    <script src="/js/high-contrast-override.js"></script>
</body>

</html>