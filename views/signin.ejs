<!DOCTYPE html>
<html lang="pt-br">

<head>

    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Login</title>

    <!-- CSS -->
    <link rel="stylesheet" href="/css/cadastro.css">

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet">

</head>

<body>

    <div class="Cadastro my-5">
        <h2>Cadastrar</h2>
        <form action="#" class="container" method="POST">

            <div class="input">
                <label for="nome">Nome</label>
                <input type="text" id="nome" name="nome" required placeholder="João Silva...">
            </div>

            <div class="input">
                <label for="username">Username</label>
                <input type="text" id="username" name="username" required placeholder="joaosilva...">
            </div>
            
    
            <div class="input">
                <label for="senha">Senha</label>
                <input type="password" id="senha" name="senha" required placeholder="...">
            </div>

           <label>Você deseja se cadastrar como:</label>

            <div class="tipo-usuario">

                <label class="tipo-opcao" for="cliente">
                    <input
                        type="radio"
                        id="cliente"
                        name="category"
                        value="user"
                        checked
                    >
                    Cliente
                </label>

                <label class="tipo-opcao" for="vendedor">
                    <input
                        type="radio"
                        id="vendedor"
                        name="category"
                        value="vendedor"
                    >
                    Vendedor
                </label>

            </div>
        
            <button type="submit">Cadastrar</button>
        </form>
        
        Já tem uma conta? <a href="/login">Entre aqui</a>
    </div>

</body>

</html>