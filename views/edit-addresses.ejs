<!DOCTYPE html>

<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

```
<title>Editar endereço</title>

<!-- Bootstrap -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
    rel="stylesheet">

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
    crossorigin="anonymous"></script>

<link rel="stylesheet" href="/css/home.css">
```

</head>

<body>

```
<header class="mb-3">

    <div class="accessibility-bar"
        role="navigation"
        aria-label="Acessibilidade">

        <a href="#maincontent" accesskey="1">
            Ir para o conteúdo
        </a>

        <button type="button"
            id="high-contrast"
            onclick="toggleContraste()"
            aria-label="Ativar alto contraste">

            Alto Contraste

        </button>

    </div>

    <nav class="site-header">

        <div class="logo">

            <a href="/" aria-label="Página inicial GalinhasGordas">

                <img src="/imagens/logo.png"
                    alt="GalinhasGordas Home"
                    width="120">

            </a>

        </div>

        <div class="d-none d-sm-flex user-actions">

            <a href="/config"
                class="action-link"
                aria-label="Minha conta">

                Minha Conta
                (<strong>@<%= USER.username %></strong>)

            </a>

            <a href="/<%= USER.username %>/shopping-cart"
                class="action-link"
                aria-label="Carrinho de compras">

                Carrinho
                (<span class="cart-badge">0</span>)

            </a>

        </div>

    </nav>

</header>


<main id="maincontent">

    <article class="container-md mt-4">

        <div class="d-flex justify-content-between align-items-center">

            <h1>Editar endereço</h1>

            <a href="/<%= USER.username %>/create_addresses"
                class="btn btn-primary">

                Voltar

            </a>

        </div>


        <div class="card card-body mt-4">

            <form method="POST"
                action="/<%= USER.username %>/edit-addresses/<%= endereco.id %>">

                <div class="mb-3">

                    <label for="local"
                        class="form-label">

                        Endereço

                    </label>

                    <input type="text"
                        class="form-control"
                        id="local"
                        name="local"
                        value="<%= endereco.local %>"
                        required>

                </div>


                <button type="submit"
                    class="btn btn-primary">

                    Salvar alterações

                </button>

            </form>

        </div>

    </article>

</main>


<link rel="stylesheet"
    href="/css/high-contrast.css">

<script src="/js/high-contrast-override.js"></script>

<link rel="stylesheet"
    href="/css/font-size.css">

<script src="/js/font-size-override.js"></script>
```

</body>

</html>
