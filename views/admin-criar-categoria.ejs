<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Criar Categoria</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>

<body>

    <header class="mb-3">
        <div class="accessibility-bar" role="navigation" aria-label="Acessibilidade">
            <a href="#main-content" accesskey="1">Ir para o conteúdo</a>

            <button
                type="button"
                id="high-contrast"
                onclick="toggleContraste()"
                aria-label="Ativar alto contraste">
                Alto Contraste
            </button>
        </div>

        <nav class="site-header">

            <div class="logo">
                <a href="/" aria-label="Página inicial GalinhasGordas">
                    <img
                        src="/imagens/logo.png"
                        alt="GalinhasGordas Home"
                        width="120">
                </a>
            </div>

            <div class="d-none d-sm-flex user-actions">

                <a href="/config" class="action-link">
                    Minha Conta
                    (<strong>@<%= USER.username %></strong>)
                </a>

                <a href="/admin" class="action-link">
                    Painel Administrativo
                </a>

            </div>

        </nav>
    </header>


    <main id="main-content" class="container-md mt-4 admin-main">

        <div class="d-flex justify-content-between align-items-center admin-header">

            <h2>Criar Categoria</h2>

            <a class="btn" href="/admin/categorias">
                Voltar
            </a>

        </div>


        <div class="container-md mt-4">

            <h3 class="admin-section-title">
                Nova categoria
            </h3>

            <p class="admin-section-description">
                Informe o nome da nova categoria.
            </p>


            <form
                action="/admin/categorias/criar"
                method="POST"
            >

                <div class="mb-3">

                    <label for="name" class="form-label">
                        Nome da categoria
                    </label>

                    <input
                        type="text"
                        class="form-control"
                        id="name"
                        name="name"
                        required
                    >

                </div>


                <div class="d-flex gap-2">

                    <button
                        type="submit"
                        class="btn btn-primary">
                        Criar categoria
                    </button>

                    <a
                        href="/admin/categorias"
                        class="btn btn-outline-secondary">
                        Cancelar
                    </a>

                </div>

            </form>

        </div>

    </main>
<link rel="stylesheet" href="/css/high-contrast.css">
    <script src="/js/high-contrast-override.js"></script>
</body>
</html>