<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Pedido concluído</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <link rel="stylesheet" href="/css/home.css">
</head>

<body>

    <header class="mb-4">

        <div class="accessibility-bar"
             role="navigation"
             aria-label="Acessibilidade">

            <a href="#maincontent" accesskey="1">
                Ir para o conteúdo
            </a>

            <button type="button"
                    onclick="toggleContraste()"
                    aria-label="Ativar alto contraste">

                Alto Contraste

            </button>

        </div>


        <nav class="site-header">

            <div class="logo">

                <a href="/" aria-label="Página inicial GalinhasGordas">

                    <img src="/imagens/logo.png"
                         alt="GalinhasGordas Home"
                         width="120">

                </a>

            </div>


            <div class="d-none d-sm-flex user-actions">

                <a href="/config"
                   class="btn btn-outline-primary">

                    Minha Conta

                </a>

                <a href="/<%= USER.username %>/shopping-cart"
                   class="action-link">

                    Carrinho

                </a>

            </div>

        </nav>

    </header>


    <main id="maincontent"
          class="container"
          style="max-width: 700px;">

            <div class="card card-body text-center mb-3">
                <h1>
                    Seus pedidos:
                </h1>            

            <% if (ITEMS.length > 0) { %>
                <div class="container-md">
                <div class="card card-body">
                <% ITEMS.forEach((item)=>{ %>
                <% let val = (item.item.produto.preco * item.item.quantidade); %>
                
                <div class="d-flex justify-content-between">
                    <p class="card-text text-start"><%= item.item.produto.name %> x<%= item.item.quantidade%></p>
                    <strong class="card-text text-end">R$ <%= val.toFixed(2) %></strong>
                </div>
                
                
                <% }) %>
                </div>
                </div>
            </div>
            <% } else { %>
            <div class="card card-body">
                <h2>Nenhum produto a ser mostrado</h2>
            </div>
            <% } %>
    </main>

</body>

</html>