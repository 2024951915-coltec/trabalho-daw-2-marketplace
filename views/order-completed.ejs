<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Pedido concluído</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <link rel="stylesheet" href="/css/home.css">
</head>

<body>

    <header class="mb-4">

        <div class="accessibility-bar"
             role="navigation"
             aria-label="Acessibilidade">

            <a href="#maincontent" accesskey="1">
                Ir para o conteúdo
            </a>

            <button type="button"
                    id="high-contrast"
                    onclick="toggleContraste()"
                    aria-label="Ativar alto contraste">

                Alto Contraste

            </button>

        </div>


        <nav class="site-header">

            <div class="logo">

                <a href="/" aria-label="Página inicial GalinhasGordas">

                    <img src="/imagens/logo.png"
                         alt="GalinhasGordas Home"
                         width="120">

                </a>

            </div>


            <div class="d-none d-sm-flex user-actions">

                <a href="/config"
                   class="btn btn-outline-primary">

                    Minha Conta

                </a>

                <a href="/<%= USER.username %>/shopping-cart"
                   class="action-link">

                    Carrinho

                </a>

            </div>

        </nav>

    </header>


    <main id="maincontent"
          class="container"
          style="max-width: 700px;">

            <div class="card card-body text-center mb-3">


                <p class="lead">

                    Sua compra foi realizada com sucesso.

                </p>


                <p class="text-secondary">

                    Obrigado por comprar na GalinhasGordas!

                </p>

                
            </div>

            <% if (ITEMS.length > 0) { %>
            <div class="card card-body ">
                <h2>Seu recibo: </h2>
                <div class="container-md">
                <% ITEMS.forEach((item)=>{ %>
                <% let val = (item.produto.preco * item.quantidade); %>
                <div class="card card-body">
                    <h3 class="card-title"><%= item.produto.name %>: R$ <%= val.toFixed(2) %></h3>
                </div>
                <% }) %>
                </div>
            </div>
            <% } else { %>
            <div class="card card-body">
                <h2>Nenhum produto a ser mostrado</h2>
            </div>
            <% } %>
    </main>
    <link rel="stylesheet" href="/css/high-contrast.css">
    <script src="/js/high-contrast-override.js"></script>
</body>

</html>