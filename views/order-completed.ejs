<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Pedido concluído</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <link rel="stylesheet" href="/css/home.css">
</head>

<body>

    <header class="mb-4">

        <div class="accessibility-bar"
             role="navigation"
             aria-label="Acessibilidade">

            <a href="#maincontent" accesskey="1">
                Ir para o conteúdo
            </a>

            <button type="button"
                    onclick="toggleContraste()"
                    aria-label="Ativar alto contraste">

                Alto Contraste

            </button>

        </div>


        <nav class="site-header">

            <div class="logo">

                <a href="/" aria-label="Página inicial GalinhasGordas">

                    <img src="/imagens/logo.png"
                         alt="GalinhasGordas Home"
                         width="120">

                </a>

            </div>


            <div class="d-none d-sm-flex user-actions">

                <a href="/config"
                   class="btn btn-outline-primary">

                    Minha Conta

                </a>

                <a href="/<%= USER.username %>/shopping-cart"
                   class="action-link">

                    Carrinho

                </a>

            </div>

        </nav>

    </header>


    <main id="maincontent"
          class="container"
          style="max-width: 700px;">

        <div class="card text-center shadow-sm">

            <div class="card-body p-5">

                <div class="mb-4">

                    <span style="font-size: 70px;">
                        ✓
                    </span>

                </div>


                <h1 class="text-success mb-3">

                    Pedido concluído!

                </h1>


                <p class="lead">

                    Sua compra foi realizada com sucesso.

                </p>


                <p class="text-secondary">

                    Obrigado por comprar na GalinhasGordas!

                </p>


                <% if (PEDIDO) { %>

                    <p class="mt-4">

                        <strong>Número do pedido:</strong>
                        #<%= PEDIDO.id %>

                    </p>

                <% } %>


                <div class="d-flex justify-content-center gap-2 mt-4">

                    <a href="/"
                       class="btn btn-primary">

                        Voltar para a página inicial

                    </a>

                    <a href="/<%= USER.username %>/orders"
                       class="btn btn-outline-primary">

                        Meus pedidos

                    </a>

                </div>

            </div>

        </div>

    </main>

</body>

</html>