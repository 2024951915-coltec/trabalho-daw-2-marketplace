<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Alterar senha</title>

    <!-- Bootstrap -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <!-- Bootstrap JS -->
    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous">
    </script>

    <link class="style-local" rel="stylesheet" href="/css/home.css">
</head>

<body>

    <!-- Header Principal -->
    <header class="mb-3">

        <!-- Barra de Acessibilidade -->
        <div class="accessibility-bar"
             role="navigation"
             aria-label="Acessibilidade">

            <a href="#maincontent" accesskey="1">
                Ir para o conteúdo
            </a>

            <button type="button"
                    id="high-contrast"
                    onclick="toggleContraste()"
                    aria-label="Ativar alto contraste">
                Alto Contraste
            </button>

        </div>

        <nav class="site-header">

            <!-- Logo -->
            <div class="logo">

                <a href="/" aria-label="Página inicial GalinhasGordas">

                    <img
                        src="/imagens/logo.png"
                        alt="GalinhasGordas Home"
                        width="120">

                </a>

            </div>

            <!-- MENU COMPUTADOR -->
            <div class="d-none d-sm-flex user-actions">

                <% if (USER) { %>

                    <!-- Minha conta -->
                    <a href="/config"
                       class="btn btn-outline-primary"
                       aria-label="Minha conta">

                        Minha Conta
                        (<strong>@<%= USER.username %></strong>)

                    </a>

                    <!-- Carrinho -->
                    <a href="/<%= USER.username %>/shopping-cart"
                       class="action-link"
                       aria-label="Ver carrinho de compras">

                        Carrinho
                        (<span class="cart-badge">0</span>)

                    </a>

                <% } else { %>

                    <a href="/login"
                       class="btn btn-outline-primary">

                        Entrar ou cadastrar

                    </a>

                    <a href="/login"
                       class="action-link">

                        Carrinho

                    </a>

                <% } %>

            </div>


            <!-- MENU TELEFONE -->
            <div class="d-block d-sm-none">

                <a class="btn btn-outline-primary"
                   data-bs-toggle="offcanvas"
                   href="#sm-offcanvas"
                   role="button"
                   aria-controls="sm-offcanvas">

                    &#9776;

                </a>


                <div class="offcanvas offcanvas-start"
                     id="sm-offcanvas">

                    <div class="offcanvas-header">

                        <h5 class="offcanvas-title">
                            Menu
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="offcanvas"
                                aria-label="Close">
                        </button>

                    </div>


                    <div class="offcanvas-body">

                        <% if (USER) { %>

                            <a href="/config"
                               class="btn btn-outline-primary mb-2">

                                Minha Conta
                                (@<%= USER.username %>)

                            </a>

                            <a href="/<%= USER.username %>/shopping-cart"
                               class="btn btn-outline-primary">

                                Carrinho
                                (<span class="cart-badge">0</span>)

                            </a>

                        <% } else { %>

                            <a href="/login"
                               class="btn btn-outline-primary mb-2">

                                Entrar ou cadastrar

                            </a>

                            <a href="/login"
                               class="btn btn-outline-primary">

                                Carrinho

                            </a>

                        <% } %>

                    </div>

                </div>

            </div>

        </nav>

    </header>


    <!-- CONTEÚDO -->
    <main id="maincontent" class="container-md">

        <div class="row justify-content-center">

            <div class="col-md-6 col-lg-5">

                <div class="card shadow-sm">

                    <div class="card-header">

                        <h1 class="h3 mb-0">
                            Alterar senha
                        </h1>

                    </div>


                    <div class="card-body">

                        <p class="text-secondary">
                            Altere a senha da sua conta preenchendo
                            os campos abaixo.
                        </p>


                        <!-- Formulário -->
                        <form action="/password_change"
                              method="POST">


                            <!-- Senha atual -->
                            <div class="mb-3">

                                <label for="oldPassword"
                                       class="form-label">

                                    Senha atual

                                </label>

                                <input
                                    type="password"
                                    class="form-control"
                                    id="oldPassword"
                                    name="oldPassword"
                                    placeholder="Digite sua senha atual"
                                    required>

                            </div>


                            <!-- Nova senha -->
                            <div class="mb-3">

                                <label for="newPassword"
                                       class="form-label">

                                    Nova senha

                                </label>

                                <input
                                    type="password"
                                    class="form-control"
                                    id="newPassword"
                                    name="newPassword"
                                    placeholder="Digite sua nova senha"
                                    required>

                            </div>


                            <!-- Confirmar nova senha -->
                            <div class="mb-3">

                                <label for="confirmPassword"
                                       class="form-label">

                                    Confirmar nova senha

                                </label>

                                <input
                                    type="password"
                                    class="form-control"
                                    id="confirmPassword"
                                    name="confirmPassword"
                                    placeholder="Digite novamente sua nova senha"
                                    required>

                            </div>


                            <!-- Botões -->
                            <div class="d-flex justify-content-between mt-4">

                                <a href="/config"
                                   class="btn btn-secondary">

                                    Cancelar

                                </a>

                                <button
                                    type="submit"
                                    class="btn btn-primary">

                                    Alterar senha

                                </button>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </main>


    <script src="/js/controle_barras_busca.js"></script>

    <link rel="stylesheet" href="/css/high-contrast.css">
    <script src="/js/high-contrast-override.js"></script>
</body>

</html>