<!DOCTYPE html>
<html lang="pt-BR">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        <title>ADMIN-VENDEDORES</title>

        <!-- Bootstrap -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
            rel="stylesheet">

        <!--Bootstrap JS Script-->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" 
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" 
        crossorigin="anonymous"></script>
        <link rel="stylesheet" href="/css/home.css">
        <link rel="stylesheet" href="/css/admin.css">
        
    </head>

    <body>
        <header class="mb-3">
            <!-- Barra de Acessibilidade Superior com as classes adicionadas -->
            <div class="accessibility-bar" role="navigation" aria-label="Acessibilidade">
                <a href="#main-content" accesskey="1">Ir para o conteúdo</a>
                <button type="button" onclick="toggleContraste()" aria-label="Ativar alto contraste">Alto Contraste</button>
            </div>
            
            <nav class="site-header">
                <!-- Logotipo -->
                <div class="logo">
                    <a href="/" aria-label="Página inicial GalinhasGordas">
                        <img src="/imagens/logo.png" alt="GalinhasGordas Home" width="120"> <!--Removeu o i-->
                    </a>
                </div>

                <!-- MENU COMPUTADOR/TV -->
                <div class="d-none d-sm-flex user-actions">
                    
                    <!-- Área de Login -->
                    <a href="/config" class="action-link" aria-label="Entrar na minha conta">
                        Minha Conta (<strong>@<%= USER.username %></strong>)
                    </a>

                    <!-- Carrinho de Compras -->
                    <a href="/<%= USER.username %>/shopping-cart" class="action-link" aria-label="Ver carrinho de compras, 0 itens">
                        Carrinho (<span class="cart-badge">0</span>)
                    </a>

                </div>

                <!-- MENU TELEFONE/PDA -->
                <div class="d-block d-sm-none">
                    <!--TODO: adicionar menu para mobile-->
                    <a class="btn btn-outline-primary" data-bs-toggle="offcanvas" href="#sm-offcanvas" role="button" aria-controls="sm-offcanvas">
                        &#9776;secondary
                    </a>

                    <div class="offcanvas offcanvas-start" id="sm-offcanvas">
                        <div class="offcanvas-header">
                            <h5 class="offcanvas-title" id="offcanvasExampleLabel">Menu</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                        </div>

                        <div class="offcanvas-body">
                            <!-- Área de Login -->
                            <a href="/config" class="btn btn-outline-primary" aria-label="Entrar na minha conta">
                                Minha Conta (<strong>@<%= USER.username %></strong>)
                            </a>

                            <!-- Carrinho de Compras -->
                            <a href="/<%= USER.username %>/shopping-cart" class="btn btn-outline-primary" aria-label="Ver carrinho de compras, 0 itens">
                                Carrinho (<span class="cart-badge">0</span>)
                            </a>
                        </div>
                    </div>
                </div>
            </nav>

        </header>

        <main id="main-content" class="container-md mt-4 admin-main">

            <div class="d-flex justify-content-between align-items-center admin-header">

                <h2>Gerenciamento de Vendedores</h2>

                <a class="btn" href="/admin">
                    Voltar
                </a>

            </div>


            <div class="container-md mt-4">

                <div class="mb-3">

                    <h3 class="admin-section-title">
                        Vendedores cadastrados
                    </h3>

                    <p class="admin-section-description">
                        Visualize e gerencie os vendedores cadastrados no sistema.
                    </p>

                </div>


                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>

                            <tr>
                                <th>ID</th>
                                <th>Nome</th>
                                <th>Usuário</th>
                                <th>Loja</th>
                                <th>Descrição</th>
                                <th>Ações</th>
                            </tr>

                        </thead>


                        <tbody>

                            <% VENDEDORES.forEach(vendedor => { %>

                                <tr>

                                    <td>
                                        <%= vendedor.id %>
                                    </td>


                                    <td>

                                        <% if (vendedor.usuario) { %>

                                            <%= vendedor.usuario.name %>

                                        <% } else { %>

                                            <span class="text-muted">
                                                Usuário não encontrado
                                            </span>

                                        <% } %>

                                    </td>


                                    <td>

                                        <% if (vendedor.usuario) { %>

                                            @<%= vendedor.usuario.username %>

                                        <% } else { %>

                                            <span class="text-muted">
                                                -
                                            </span>

                                        <% } %>

                                    </td>


                                    <td>

                                        <% if (vendedor.loja) { %>

                                            <%= vendedor.loja.name %>

                                        <% } else { %>

                                            <span class="text-muted">
                                                Sem loja
                                            </span>

                                        <% } %>

                                    </td>


                                    <td>
                                        <%= vendedor.description %>
                                    </td>


                                    <td>

                                        <a
                                            href="/admin/vendedores/<%= vendedor.id %>/editar"
                                            class="btn btn-sm btn-outline-primary"
                                        >
                                            Editar
                                        </a>


                                        <form
                                            action="/admin/vendedores/<%= vendedor.id %>/excluir"
                                            method="POST"
                                            class="d-inline"
                                        >

                                            <button
                                                type="submit"
                                                class="btn btn-sm btn-outline-danger"
                                            >
                                                Excluir
                                            </button>

                                        </form>

                                    </td>

                                </tr>

                            <% }) %>

                        </tbody>

                    </table>

                </div>

            </div>

        </main>
        <link rel="stylesheet" href="/css/high-contrast.css">
        <script src="/js/high-contrast-override.js"></script>
    </body>
</html>