<!DOCTYPE html>

<html lang="pt-BR">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        <title>Ver produtos</title>

        <!-- Bootstrap -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
            rel="stylesheet">

        <!--Bootstrap JS Script-->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" 
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" 
        crossorigin="anonymous"></script>

        <link class="style-local" rel="stylesheet" href="/css/home.css">
    </head>

    <body>
        <header class="mb-3">
            <!-- Barra de Acessibilidade Superior com as classes adicionadas -->
            <div class="accessibility-bar" role="navigation" aria-label="Acessibilidade">
                <a href="#main-content" accesskey="1">Ir para o conteúdo</a>
                <button type="button" onclick="toggleContraste()" aria-label="Ativar alto contraste">Alto Contraste</button>
            </div>
            
            <nav class="site-header">
                <!-- Logotipo -->
                <div class="logo">
                    <a href="/" aria-label="Página inicial GalinhasGordas">
                        <img src="/imagens/logo.png" alt="GalinhasGordas Home" width="120"> <!--Removeu o i-->
                    </a>
                </div>

                <!-- MENU COMPUTADOR/TV -->
                <div class="d-none d-sm-flex user-actions">
                    
                    <!-- Área de Login -->
                    <a href="/config" class="action-link" aria-label="Entrar na minha conta">
                        Minha Conta (<strong>@<%= USER.username %></strong>)
                    </a>

                    <!-- Carrinho de Compras -->
                    <a href="/carrinho" class="action-link" aria-label="Ver carrinho de compras, 0 itens">
                        Carrinho (<span class="cart-badge">0</span>)
                    </a>

                </div>

                <!-- MENU TELEFONE/PDA -->
                <div class="d-block d-sm-none">
                    <!--TODO: adicionar menu para mobile-->
                    <a class="btn btn-outline-primary" data-bs-toggle="offcanvas" href="#sm-offcanvas" role="button" aria-controls="sm-offcanvas">
                        &#9776;secondary
                    </a>

                    <div class="offcanvas offcanvas-start" id="sm-offcanvas">
                        <div class="offcanvas-header">
                            <h5 class="offcanvas-title" id="offcanvasExampleLabel">Menu</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                        </div>

                        <div class="offcanvas-body">
                            <!-- Área de Login -->
                            <a href="/config" class="btn btn-outline-primary" aria-label="Entrar na minha conta">
                                Minha Conta (<strong>@<%= USER.username %></strong>)
                            </a>

                            <!-- Carrinho de Compras -->
                            <a href="/carrinho" class="btn btn-outline-primary" aria-label="Ver carrinho de compras, 0 itens">
                                Carrinho (<span class="cart-badge">0</span>)
                            </a>
                        </div>
                    </div>
                </div>
            </nav>

        </header>

        <main id="maincontent" class="container-md mt-4">
            <div class="d-flex justify-content-between align-items-center">
                <h1>Ver produtos</h1>
                <a class="btn btn-primary" href="/config/vendedor">Voltar</a>
            </div>

            <div class="container-md mt-4">
                <% PRODUTOS.forEach((produto, idx, arr) => { %>
                    <% if(idx % 3 == 0) { %>
                        <div class="row">
                    <% } %>

                    <div class="col-md-4">
                        <div class="card">
                            <a href="<link para a página do produto>" class="h3 card-header link-underline link-underline-opacity-0"> 
                                <%= produto.name %> 
                            </a>

                            <div class="card-body">
                                <p class="card-subtitle fw-semibold text-secondary">
                                    <%= produto.description %>
                                </p>
                                <p class="card-text">
                                    Preço: R$ <%= produto.preco.toFixed(2) %>
                                </p>
                                <p class="card-text">
                                    Loja:
                                    <strong>
                                        <%= produto.loja.name %>
                                    </strong>
                                </p>   
                            </div>

                            <div class="card-footer d-flex justify-content-between">
                                <a href="/config/vendedor/ver-produto/<%= produto.id %>/editar" class="btn btn-primary">Editar</a>
                                <a href="/config/vendedor/ver-produto/<%= produto.id %>/deletar" class="btn btn-danger">Deletar</a>
                            </div>
                        </div>
                    </div>

                    <% if(idx % 3 == 2 || idx == arr.length - 1) { %>
                        </div>
                    <% } %>
                <% }) %>
            </div>
        </main>
    </body>
</html>