<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Criar endereço</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYWjRjV"
        crossorigin="anonymous"></script>

    <link class="style-local" rel="stylesheet" href="/css/vendedor.css">
</head>

<body>

    <header class="mb-3">

        <div class="accessibility-bar"
            role="navigation"
            aria-label="Acessibilidade">

            <a href="#maincontent" accesskey="1">
                Ir para o conteúdo
            </a>

            <button type="button"
                id="high-contrast"
                onclick="toggleContraste()"
                aria-label="Ativar alto contraste">

                Alto Contraste

            </button>

        </div>

        <nav class="site-header">

            <div class="logo">

                <a href="/" aria-label="Página inicial GalinhasGordas">

                    <img src="/imagens/logo.png"
                        alt="GalinhasGordas Home"
                        width="120">

                </a>

            </div>


            <div class="d-none d-sm-flex user-actions">

                <% if(USER) { %>

                    <a href="/config"
                        class="btn btn-outline-primary">

                        Minha Conta
                        (<strong>@<%= USER.username %></strong>)

                    </a>

                    <a href="/<%= USER.username %>/shopping-cart"
                        class="action-link">

                        Carrinho

                    </a>

                <% } else { %>

                    <a href="/login"
                        class="btn btn-outline-primary">

                        Entrar ou cadastrar

                    </a>

                <% } %>

            </div>

        </nav>

    </header>


    <main id="maincontent" class="container-md">

        <div class="d-flex justify-content-between align-items-center">

            <h1>
                Endereços
            </h1>

            <a class="btn btn-primary"
                href="/config">

                Voltar

            </a>

        </div>


        <article class="container-md row mt-3">


            <div class="col-md-6">

                <div class="card">

                    <div class="card-header">

                        <h2 class="h4 mb-0">
                            Criar endereço
                        </h2>

                    </div>

                    <div class="card-body">

                        <form action="/<$= USER.username %>/create_addresses"
                            method="POST">

                            <div class="mb-3">

                                <label for="local"
                                    class="form-label">

                                    Endereço

                                </label>

                                <input
                                    type="text"
                                    id="local"
                                    name="local"
                                    class="form-control"
                                    placeholder="Digite seu endereço"
                                    required
                                >

                            </div>


                            <button
                                type="submit"
                                class="btn btn-primary">

                                Criar endereço

                            </button>

                        </form>

                    </div>

                </div>

            </div>


            <div class="col-md-6 mt-4 mt-md-0">

                <div class="card">

                    <div class="card-header">

                        <h2 class="h4 mb-0">
                            Meus endereços
                        </h2>

                    </div>

                    <div class="card-body">

                        <% if (ENDERECOS && ENDERECOS.length > 0) { %>

                            <% ENDERECOS.forEach(endereco => { %>

                                <div class="card mb-3">

                                    <div class="card-body">

                                        <p class="mb-2">

                                            <strong>
                                                Endereço:
                                            </strong>

                                            <%= endereco.local %>

                                        </p>

                                        <a
                                            href="/config/edit-addresses/<%= endereco.id %>"
                                            class="btn btn-outline-primary">

                                            Editar

                                        </a>

                                    </div>

                                </div>

                            <% }) %>

                        <% } else { %>

                            <p class="text-secondary mb-0">

                                Você ainda não possui endereços cadastrados.

                            </p>

                        <% } %>

                    </div>

                </div>

            </div>


        </article>

    </main>
    <link rel="stylesheet" href="/css/high-contrast.css">
    <script src="/js/high-contrast-override.js"></script>
    <link rel="stylesheet" href="/css/font-size.css">
    <script src="/js/font-size-override.js"></script>
</body>

</html>