<!DOCTYPE html>
<html lang="pt-br">

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        <title>Editar produto</title>

        <link rel="stylesheet" href="/css/vendedor.css">

        <!-- Bootstrap -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
            rel="stylesheet">

        <!--Bootstrap JS Script-->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" 
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" 
        crossorigin="anonymous"></script>

        <link class="style-local" rel="stylesheet" href="/css/home.css">
    </head>

    <body>
        <header class="mb-3">
            <!-- Barra de Acessibilidade Superior com as classes adicionadas -->
            <div class="accessibility-bar" role="navigation" aria-label="Acessibilidade">
                <a href="#main-content" accesskey="1">Ir para o conteúdo</a>
                <button type="button" onclick="toggleContraste()" aria-label="Ativar alto contraste">Alto Contraste</button>
            </div>
            
            <nav class="site-header">
                <!-- Logotipo -->
                <div class="logo">
                    <a href="/" aria-label="Página inicial GalinhasGordas">
                        <img src="/imagens/logo.png" alt="GalinhasGordas Home" width="120"> <!--Removeu o i-->
                    </a>
                </div>

                <!-- MENU COMPUTADOR/TV -->
                <div class="d-none d-sm-flex user-actions">
                    
                    <!-- Área de Login -->
                    <a href="/config" class="action-link" aria-label="Entrar na minha conta">
                        Minha Conta (<strong>@<%= USER.username %></strong>)
                    </a>

                    <!-- Carrinho de Compras -->
                    <a href="/<%= USER.username %>/shopping-cart" class="action-link" aria-label="Ver carrinho de compras, 0 itens">
                        Carrinho (<span class="cart-badge">0</span>)
                    </a>

                </div>

                <!-- MENU TELEFONE/PDA -->
                <div class="d-block d-sm-none">
                    <!--TODO: adicionar menu para mobile-->
                    <a class="btn btn-outline-primary" data-bs-toggle="offcanvas" href="#sm-offcanvas" role="button" aria-controls="sm-offcanvas">
                        &#9776;secondary
                    </a>

                    <div class="offcanvas offcanvas-start" id="sm-offcanvas">
                        <div class="offcanvas-header">
                            <h5 class="offcanvas-title" id="offcanvasExampleLabel">Menu</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                        </div>

                        <div class="offcanvas-body">
                            <!-- Área de Login -->
                            <a href="/config" class="btn btn-outline-primary" aria-label="Entrar na minha conta">
                                Minha Conta (<strong>@<%= USER.username %></strong>)
                            </a>

                            <!-- Carrinho de Compras -->
                            <a href="/<%= USER.username %>/shopping-cart" class="btn btn-outline-primary" aria-label="Ver carrinho de compras, 0 itens">
                                Carrinho (<span class="cart-badge">0</span>)
                            </a>
                        </div>
                    </div>
                </div>
            </nav>

        </header>

        <main class="adicionar-produto container-md">

            <h2>Editar Produto</h2>

            <form
            class="form-control"
            action="/config/vendedor/ver-produto/<%= produto.id %>/editar"
            method="POST"
            >

                <div class="campo-produto mb-3">

                    <label for="name" class="form-label">
                        Nome do produto
                    </label>

                    <input
                        type="text"
                        class="form-control"
                        id="name"
                        name="name"
                        value="<%= produto.name %>"
                        required
                        >

                </div>


                <div class="campo-produto mb-3">
                    <label for="description" class="form-label">
                        Descrição do produto
                    </label>

                    <textarea
                    id="description"
                    class="form-control"
                    name="description"
                    ><%= produto.description %>
                    </textarea>


                </div>

                <div class="campo-produto mb-3">
                    <label for="stock" class="form-label">
                        Estoque do produto
                    </label>

                    <input
                    type="text"
                    id="Estoque"
                    class="form-control"
                    name="stock"
                    value="<%= produto.stock %>"
                    required
                    >
                </div>

                <div class="campo-produto   mb-3">

                    <label for="categoriaId" class="form-label">
                        Categoria
                    </label>

                    <select class="form-control "
                        name="categoriaId"
                        id="categoriaId"
                        required
                    >

                        <% categorias.forEach(categoria => { %>

                            <option
                                value="<%= categoria.id %>"
                                <%= produto.category == categoria.id ? 'selected' : '' %>
                            >
                                <%= categoria.name %>
                            </option>

                        <% }) %>

                    </select>
                </div>

             <button type="submit" class="btn btn-primary">
                Salvar alterações
            </button>

            </form>


        </main>


    </body>


</html>