<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>home</title>

     <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <!--Bootstrap JS Script-->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" 
    integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" 
    crossorigin="anonymous"></script>

    <link class="style-local" rel="stylesheet" href="/css/vendedor.css">
    
</head>

<body>
        
    

    <!-- Header Principal com as classes adicionadas -->
    <header class="mb-3">
        <!-- Barra de Acessibilidade Superior com as classes adicionadas -->
        <div class="accessibility-bar" role="navigation" aria-label="Acessibilidade">
            <a href="#main-content" accesskey="1">Ir para o conteúdo</a>
            <button type="button" onclick="toggleContraste()" aria-label="Ativar alto contraste">Alto Contraste</button>
        </div>
        
        <nav class="site-header">
            <!-- Logotipo -->
            <div class="logo">
                <a href="/" aria-label="Página inicial GalinhasGordas">
                    <img src="/imagens/logo.png" alt="GalinhasGordas Home" width="120"> <!--Removeu o i-->
                </a>
            </div>

            <!-- MENU COMPUTADOR/TV -->
            <div class="d-none d-sm-flex user-actions">
                
                <!-- Área de Login -->
                <a href="/login" class="action-link" aria-label="Entrar na minha conta">
                    Minha Conta / Entrar
                </a>
                
            </div>

            <!-- MENU TELEFONE/PDA -->
            <div class="d-block d-sm-none">
                <!--TODO: adicionar menu para mobile-->
                <a class="btn btn-outline-secondary" data-bs-toggle="offcanvas" href="#sm-offcanvas" role="button" aria-controls="sm-offcanvas">
                    &#9776;
                </a>

                <div class="offcanvas offcanvas-start" id="sm-offcanvas">
                    <div class="offcanvas-header">
                        <h5 class="offcanvas-title" id="offcanvasExampleLabel">Menu</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                    </div>

                    <div class="offcanvas-body">
                        <!-- Área de Login -->
                        <a href="/login" class="btn btn-outline-primary" aria-label="Entrar na minha conta">
                            Minha Conta / Entrar
                        </a>

                    </div>
                </div>
            </div>
        </nav>

    </header>

    <main id="maincontent" class="container-md">
        <h1>Bem vindo, <strong><%= USER.name %></strong>!</h1>
        <p>Gerencie sua loja e seus produtos.</p>
        <!--A página principal -->
        <article class="container-md row mt-3">
        <form action="/vendedor/produto" class="form-control" method="POST">

            <div class="mb-3">
                <label class="form-label" for="name">Nome do produto</label>
                <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    class="form-control"
                >
            </div>

            <div class="mb-3">
                <label class="form-label" for="description">Descrição</label>
                <textarea
                    id="description"
                    name="description"
                    class="form-control"
                ></textarea>
            </div>

            <div class="mb-3">
                <label for="preco">Preco</label>
                <input
                    type="number"
                    id="preco"
                    name="preco"
                    min="0"
                    class="form-control"
                    step=".01"
                    required
                >
            </div>

            <div class="mb-3">
                <label for="stock">Estoque</label>
                <input
                    type="number"
                    id="stock"
                    name="stock"
                    min="0"
                    class="form-control"
                    required
                >
            </div>

            <div class="mb-3">
                <label class="form-label" for="categoriaId">Categoria</label>
                <select class="form-select" name="categoriaId" id="categoriaId" required>
                    <option selected>Selecione uma categoria</option>
                    <% categorias.forEach(categoria => { %>
                        <option value="<%= categoria.id %>">
                            <%= categoria.name %>
                        </option>
                    <% }) %>
                </select>
            </div>

            <button class="btn btn-primary" type="submit">
                Adicionar produto
            </button>

            <aside class="destaque col-md-6 mt-3">   
                
                <h2>Produtos disponíveis</h2>
                <% produtos.forEach((produto, idx) => { %>
                <% if(idx % 2 == 0) { %>
                <div class="row mb-md-3">
                <% } %>
                    
                    <div class="col-md-6 mb-3">
                        <!--Exemplo de cartão-->
                        <div class="card card-body">
                            <h3 class="card-title">
                                <%= produto.name %>
                            </h3>
                            <p class="card-subtitle fw-semibold text-secondary">
                                <%= produto.description %>
                            </p>
                            <p class="card-text">
                                Estoque: <%= produto.stock %>
                            </p>
                            <p class="card-text">
                                Loja:
                                <strong>
                                    <%= produto.loja.name %>
                                </strong>
                            </p>

                             <a href="/vendedor/produto/<%= produto.id %>/editar"
                                class="botao-editar">
                                    Editar produto
                            </a>
                        </div>
                        <!--Exemplo de cartão-->
                    </div>
                    
                <% if(idx % 2 == 0) { %>
                </div>
                <% } %>
                <% }) %>
            </aside>

        </form>
        </article>
    </main>


    
</html>