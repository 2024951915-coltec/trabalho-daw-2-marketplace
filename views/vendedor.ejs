<!DOCTYPE html>
<html lang="pt-BR">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        <title>Configurações de usuário</title>

        <!-- Bootstrap -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
            rel="stylesheet">

        <!--Bootstrap JS Script-->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" 
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" 
        crossorigin="anonymous"></script>

        <link class="style-local" rel="stylesheet" href="/css/home.css">
    </head>

    <body>
        <header class="mb-3">
            <!-- Barra de Acessibilidade Superior com as classes adicionadas -->
            <div class="accessibility-bar" role="navigation" aria-label="Acessibilidade">
                <a href="#main-content" accesskey="1">Ir para o conteúdo</a>
                <button type="button" onclick="toggleContraste()" aria-label="Ativar alto contraste">Alto Contraste</button>
            </div>
            
            <nav class="site-header">
                <!-- Logotipo -->
                <div class="logo">
                    <a href="/" aria-label="Página inicial GalinhasGordas">
                        <img src="/imagens/logo.png" alt="GalinhasGordas Home" width="120"> <!--Removeu o i-->
                    </a>
                </div>

                <!-- MENU COMPUTADOR/TV -->
                <div class="d-none d-sm-flex user-actions">
                    
                    <!-- Área de Login -->
                    <a href="/config" class="action-link" aria-label="Entrar na minha conta">
                        Minha Conta (<strong>@<%= USER.username %></strong>)
                    </a>

                    <!-- Carrinho de Compras -->
                    <a href="/<%= USER.username %>/shopping-cart" class="action-link" aria-label="Ver carrinho de compras, 0 itens">
                        Carrinho (<span class="cart-badge">0</span>)
                    </a>

                </div>

                <!-- MENU TELEFONE/PDA -->
                <div class="d-block d-sm-none">
                    <!--TODO: adicionar menu para mobile-->
                    <a class="btn btn-outline-primary" data-bs-toggle="offcanvas" href="#sm-offcanvas" role="button" aria-controls="sm-offcanvas">
                        &#9776;secondary
                    </a>

                    <div class="offcanvas offcanvas-start" id="sm-offcanvas">
                        <div class="offcanvas-header">
                            <h5 class="offcanvas-title" id="offcanvasExampleLabel">Menu</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                        </div>

                        <div class="offcanvas-body">
                            <!-- Área de Login -->
                            <a href="/config" class="btn btn-outline-primary" aria-label="Entrar na minha conta">
                                Minha Conta (<strong>@<%= USER.username %></strong>)
                            </a>

                            <!-- Carrinho de Compras -->
                            <a href="/<%= USER.username %>/shopping-cart" class="btn btn-outline-primary" aria-label="Ver carrinho de compras, 0 itens">
                                Carrinho (<span class="cart-badge">0</span>)
                            </a>
                        </div>
                    </div>
                </div>
            </nav>

        </header>

        <main id="maincontent" class="container-md mt-4">

            <div class="d-flex justify-content-between align-items-center">
                <h2>Loja do <%= USER.name %>:</h2>
                <a class="btn btn-primary" href="/config">Voltar</a>
            </div>
            
            <div class="container-md mt-4">
                <h3>Configurações: </h3>
                <div class="row mt-3">
                    <div class="col-md-3 mb-3">
                        <div class="card card-body">
                            <a href="/config/vendedor/criar-produto" class="h3 card-title link-underline link-underline-opacity-0">
                                Criar produto
                            </a>
                            <p class="card-text">Adicionar um produto à sua loja</p>
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <div class="card card-body">
                            <a href="/config/vendedor/ver-produto" class="h3 card-title link-underline link-underline-opacity-0">
                                Ver produtos
                            </a>
                            <p class="card-text">Ver a lista completa de produtos</p>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </body>
</html>