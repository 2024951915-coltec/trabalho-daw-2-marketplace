<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Checkout - GalinhasGordas</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>

    <link class="style-local" rel="stylesheet" href="/css/home.css">
</head>

<body>

    <header class="mb-4">

        <div class="accessibility-bar"
             role="navigation"
             aria-label="Acessibilidade">

            <a href="#maincontent" accesskey="1">
                Ir para o conteúdo
            </a>

            <button type="button"
                    onclick="toggleContraste()"
                    aria-label="Ativar alto contraste">

                Alto Contraste

            </button>

        </div>


        <nav class="site-header">

            <div class="logo">

                <a href="/" aria-label="Página inicial GalinhasGordas">

                    <img src="/imagens/logo.png"
                         alt="GalinhasGordas Home"
                         width="120">

                </a>

            </div>


            <div class="d-none d-sm-flex user-actions">

                <% if (USER) { %>

                    <a href="/config"
                       class="btn btn-outline-primary">

                        Minha Conta
                        (<strong>@<%= USER.username %></strong>)

                    </a>

                    <a href="/<%= USER.username %>/shopping-cart"
                       class="action-link">

                        Carrinho

                    </a>

                <% } else { %>

                    <a href="/login"
                       class="btn btn-outline-primary">

                        Entrar ou cadastrar

                    </a>

                <% } %>

            </div>


            <div class="d-block d-sm-none">

                <a class="btn btn-outline-primary"
                   data-bs-toggle="offcanvas"
                   href="#sm-offcanvas"
                   role="button">

                    &#9776;

                </a>


                <div class="offcanvas offcanvas-start"
                     id="sm-offcanvas">

                    <div class="offcanvas-header">

                        <h5 class="offcanvas-title">
                            Menu
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="offcanvas">
                        </button>

                    </div>


                    <div class="offcanvas-body">

                        <% if (USER) { %>

                            <a href="/config"
                               class="btn btn-outline-primary mb-2">

                                Minha Conta
                                (<strong>@<%= USER.username %></strong>)

                            </a>

                            <a href="/<%= USER.username %>/shopping-cart"
                               class="btn btn-outline-primary">

                                Carrinho

                            </a>

                        <% } else { %>

                            <a href="/login"
                               class="btn btn-outline-primary">

                                Entrar ou cadastrar

                            </a>

                        <% } %>

                    </div>

                </div>

            </div>

        </nav>

    </header>


    <main id="maincontent" class="container-md">

        <h1 class="mb-4">
            💳 Checkout
        </h1>


        <div class="mb-5">

            <div class="row text-center">

                <div class="col">
                    <div class="fw-bold">
                        1. Escolher endereço
                    </div>
                </div>

                <div class="col">
                    <div class="fw-bold">
                        2. Forma de entrega
                    </div>
                </div>

                <div class="col">
                    <div class="fw-bold">
                        3. Pagamento
                    </div>
                </div>

                <div class="col">
                    <div class="fw-bold">
                        4. Confirmar compra
                    </div>
                </div>

            </div>

        </div>


        <form action="/checkout"
              method="POST"
              id="checkoutForm">


            <input type="hidden"
                   name="tipoCompra"
                   value="<%= TIPO_COMPRA %>">


            <% if (TIPO_COMPRA === 'comprarAgora' && PRODUTO) { %>

                <input type="hidden"
                       name="produtoId"
                       value="<%= PRODUTO.id %>">


                <input type="hidden"
                       name="quantidade"
                       value="<%= PRODUTO.quantidade || 1 %>">

            <% } %>


            <section class="card mb-4">

                <div class="card-header">

                    <h2 class="h4 mb-0">
                        1. Escolher endereço
                    </h2>

                </div>


                <div class="card-body">

                    <% if (ENDERECOS && ENDERECOS.length > 0) { %>

                        <label for="enderecoId"
                               class="form-label">

                            Selecione o endereço de entrega:

                        </label>


                        <select class="form-select"
                                id="enderecoId"
                                name="enderecoId"
                                required>

                            <option value="" selected disabled>
                                Selecione um endereço
                            </option>


                            <% ENDERECOS.forEach(endereco => { %>

                                <option value="<%= endereco.id %>">

                                    <%= endereco.rua %>

                                    <% if (endereco.numero) { %>
                                        , <%= endereco.numero %>
                                    <% } %>

                                    <% if (endereco.bairro) { %>
                                        - <%= endereco.bairro %>
                                    <% } %>

                                </option>

                            <% }) %>

                        </select>

                    <% } else { %>

                        <div class="alert alert-warning">

                            Você não possui nenhum endereço cadastrado.

                        </div>


                        <a href="/<%= USER.username %>/create_addresses"
                           class="btn btn-primary">

                            Cadastrar endereço

                        </a>

                    <% } %>

                </div>

            </section>


            <section class="card mb-4">

                <div class="card-header">

                    <h2 class="h4 mb-0">
                        2. Escolher forma de entrega
                    </h2>

                </div>


                <div class="card-body">

                    <div class="form-check mb-3">

                        <input class="form-check-input"
                               type="radio"
                               name="formaEntrega"
                               id="entregaNormal"
                               value="normal"
                               checked
                               required>

                        <label class="form-check-label"
                               for="entregaNormal">

                            Entrega normal

                            <br>

                            <small class="text-secondary">
                                Prazo padrão de entrega
                            </small>

                        </label>

                    </div>


                    <div class="form-check mb-3">

                        <input class="form-check-input"
                               type="radio"
                               name="formaEntrega"
                               id="entregaExpressa"
                               value="expressa">

                        <label class="form-check-label"
                               for="entregaExpressa">

                            Entrega expressa

                            <br>

                            <small class="text-secondary">
                                Entrega mais rápida
                            </small>

                        </label>

                    </div>

                </div>

            </section>


            <section class="card mb-4">

                <div class="card-header">

                    <h2 class="h4 mb-0">
                        3. Escolher pagamento
                    </h2>

                </div>


                <div class="card-body">

                    <% if (CARTOES && CARTOES.length > 0) { %>

                        <label for="cartaoId"
                               class="form-label">

                            Cartão:

                        </label>


                        <select class="form-select mb-3"
                                id="cartaoId"
                                name="cartaoId"
                                required>

                            <option value="" selected disabled>
                                Selecione um cartão
                            </option>


                            <% CARTOES.forEach(cartao => { %>

                                <option value="<%= cartao.id %>">

                                    Cartão terminado em
                                    <%= String(cartao.numero).slice(-4) %>

                                </option>

                            <% }) %>

                        </select>


                        <p class="text-secondary mb-0">

                            O pagamento será realizado utilizando
                            um cartão associado à sua conta.

                        </p>

                    <% } else { %>

                        <div class="alert alert-warning">

                            Você não possui nenhum cartão cadastrado.

                        </div>


                        <a href="/<%= USER.username %>/cartoes"
                           class="btn btn-primary">

                            Cadastrar cartão

                        </a>

                    <% } %>

                </div>

            </section>


            <section class="card mb-4">

                <div class="card-header">

                    <h2 class="h4 mb-0">
                        4. Confirmar compra
                    </h2>

                </div>


                <div class="card-body">


                    <% if (TIPO_COMPRA === 'comprarAgora' && PRODUTO) { %>

                        <h3 class="h5">
                            Produto
                        </h3>


                        <div class="d-flex justify-content-between
                                    align-items-center mb-3">

                            <div>

                                <strong>
                                    <%= PRODUTO.name %>
                                </strong>

                                <br>

                                <span class="text-secondary">

                                    Quantidade:
                                    <%= PRODUTO.quantidade || 1 %>

                                </span>

                            </div>


                            <span class="fw-bold">

                                R$
                                <%= (
                                    PRODUTO.preco *
                                    (PRODUTO.quantidade || 1)
                                ).toFixed(2) %>

                            </span>

                        </div>


                        <hr>


                        <div class="d-flex justify-content-between">

                            <strong>
                                Total
                            </strong>

                            <strong>

                                R$
                                <%= (
                                    PRODUTO.preco *
                                    (PRODUTO.quantidade || 1)
                                ).toFixed(2) %>

                            </strong>

                        </div>


                    <% } else if (TIPO_COMPRA === 'carrinho' && CARRINHO) { %>

                        <h3 class="h5">
                            Produtos do carrinho
                        </h3>


                        <% if (CARRINHO.itens && CARRINHO.itens.length > 0) { %>

                            <% CARRINHO.itens.forEach(item => { %>

                                <div class="d-flex
                                            justify-content-between
                                            align-items-center
                                            mb-3">

                                    <div>

                                        <strong>
                                            <%= item.produto.name %>
                                        </strong>

                                        <br>

                                        <span class="text-secondary">

                                            Quantidade:
                                            <%= item.quantidade %>

                                        </span>

                                    </div>


                                    <span class="fw-bold">

                                        R$
                                        <%= item.valorItem.toFixed(2) %>

                                    </span>

                                </div>

                            <% }) %>

                        <% } %>


                        <hr>


                        <div class="d-flex justify-content-between">

                            <strong>
                                Total
                            </strong>

                            <strong>

                                R$
                                <%= CARRINHO.valorTotalCompra.toFixed(2) %>

                            </strong>

                        </div>

                    <% } %>

                </div>

            </section>


            <div class="card mb-5">

                <div class="card-body">

                    <div class="form-check mb-3">

                        <input class="form-check-input"
                               type="checkbox"
                               id="confirmacao"
                               required>

                        <label class="form-check-label"
                               for="confirmacao">

                            Confirmo que os dados da compra estão corretos.

                        </label>

                    </div>


                    <button type="submit"
                            class="btn btn-success btn-lg w-100">

                        Confirmar compra

                    </button>

                </div>

            </div>

        </form>

    </main>


    <script>

        const checkoutForm =
            document.getElementById('checkoutForm');


        checkoutForm.addEventListener('submit', function (event) {

            const endereco =
                document.getElementById('enderecoId');


            const cartao =
                document.getElementById('cartaoId');


            if (!endereco || !endereco.value) {

                event.preventDefault();

                alert('Escolha um endereço.');

                return;

            }


            if (!cartao || !cartao.value) {

                event.preventDefault();

                alert('Escolha uma forma de pagamento.');

                return;

            }

        });

    </script>


</body>

</html>